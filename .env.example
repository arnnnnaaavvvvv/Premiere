# Environment Configuration
# Copy this file to .env and adjust variables as needed

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./reelforge.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/reelforge
REDIS_URL=redis://localhost:6379/0

# LLM Providers (OpenAI or Anthropic or Fallback Mock)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage & Egress
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000

# API Security & Rate Limits
RATE_LIMIT_PER_MINUTE=20
SSRF_PROTECTION_ENABLED=true

# Worker Concurrency
WORKER_CONCURRENCY=2
VIDEO_RENDER_FPS=30
VIDEO_RENDER_WIDTH=1920
VIDEO_RENDER_HEIGHT=1080
